<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/usuario_foto"
        android:layout_width="100dp"
        android:layout_height="60dp"
        android:src="@drawable/usuario1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/nome_usuario"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Fabio Claret"
        android:textColor="@color/black"
        android:textSize="25dp"
        android:textStyle="bold"
        app:layout_constraintStart_toEndOf="@+id/usuario_foto"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="10dp"
        android:layout_marginStart="20dp"
        />
    <TextView
        android:id="@+id/mensagem"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Vamos para Casa"
        android:textSize="16dp"
        app:layout_constraintTop_toBottomOf="@+id/nome_usuario"
        app:layout_constraintStart_toEndOf="@+id/usuario_foto"
        android:layout_marginStart="20dp"
        />

    <View
        android:id="@+id/linha"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="#A6A4A4"
        android:layout_marginStart="20dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/usuario_foto"
        app:layout_constraintTop_toBottomOf="@+id/mensagem"
        />


</androidx.constraintlayout.widget.ConstraintLayout>